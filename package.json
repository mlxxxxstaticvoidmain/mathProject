{
  "name": "numerical-notes",
  "productName": "Численные методы",
  "version": "1.0.0",
  "description": "Конспекты по численным методам: формулы, графики, таблицы",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "sync-vendor": "node scripts/sync-vendor.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "keywords": [
    "notes",
    "latex",
    "numerical-methods"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.numericalnotes.app",
    "productName": "Численные методы",
    "artifactName": "NumericalNotes-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "NumericalNotes-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "NumericalNotes-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
